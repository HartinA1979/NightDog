<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="NightDog.App.Views.DiaryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:NightDog.App.ViewModels"
    x:DataType="vm:DiaryViewModel"
    Title="Tagebuch">

    <ScrollView>
        <VerticalStackLayout Padding="24,20,24,24" Spacing="16">

            <VerticalStackLayout Spacing="2">
                <Label Text="Was beeinflusst dein Schnarchen?" Style="{StaticResource Caption}" />
                <Label Text="Tagebuch" Style="{StaticResource H1}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource InfoBox}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Image Source="icon_info.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Start">
                        <Image.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Dark={StaticResource PrimaryBrightDark}, Light={StaticResource PrimaryBrightLight}}" />
                        </Image.Behaviors>
                    </Image>
                    <Label Grid.Column="1" Text="Das Faktoren-Tagebuch (mit/ohne Vergleich) folgt in Phase 7." Style="{StaticResource Body}" FontSize="13" />
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
