<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="NightDog.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:NightDog.App.ViewModels"
    x:DataType="vm:SettingsViewModel"
    Title="Einstellungen">

    <ScrollView>
        <VerticalStackLayout Padding="24,20,24,24" Spacing="16">

            <VerticalStackLayout Spacing="2">
                <Label Text="NightDog" Style="{StaticResource Caption}" />
                <Label Text="Einstellungen" Style="{StaticResource H1}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource InfoBox}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Image Source="icon_info.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Start">
                        <Image.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Dark={StaticResource PrimaryBrightDark}, Light={StaticResource PrimaryBrightLight}}" />
                        </Image.Behaviors>
                    </Image>
                    <Label Grid.Column="1" Text="Aufnahme-, Erkennungs- und Datenschutz-Einstellungen folgen in den Phasen 2, 3, 5 und 7." Style="{StaticResource Body}" FontSize="13" />
                </Grid>
            </Border>

            <VerticalStackLayout Spacing="8">
                <Label Text="Darstellung" Style="{StaticResource Eyebrow}" />
                <Border Style="{StaticResource Card}" Padding="16">
                    <Border Style="{StaticResource SegmentTrack}">
                        <FlexLayout Direction="Row" BindableLayout.ItemsSource="{Binding ThemeOptions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ThemeOption">
                                    <Border Style="{StaticResource Segment}" FlexLayout.Grow="1" FlexLayout.Basis="0" Margin="2,0" HeightRequest="40">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding SelectThemeCommand, Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, x:DataType=vm:SettingsViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Label}" Style="{StaticResource SegmentLabel}" FontSize="14">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource White}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </Border>
                </Border>
            </VerticalStackLayout>

            <Label
                Text="NightDog ist kein Medizinprodukt und stellt keine Diagnose. Bei Verdacht auf Atemaussetzer bitte ärztlich abklären lassen."
                Style="{StaticResource Caption}"
                FontSize="12"
                HorizontalTextAlignment="Center" />

            <Label Text="{Binding AppVersion}" Style="{StaticResource Caption}" FontSize="12" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
