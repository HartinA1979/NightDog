<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="NightDog.App.Views.NightDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:NightDog.App.ViewModels"
    x:DataType="vm:NightDetailViewModel"
    Title="Nacht-Details">

    <ScrollView>
        <VerticalStackLayout Padding="24,20,24,24" Spacing="16">

            <VerticalStackLayout Spacing="2">
                <Label Text="Timeline und Episoden" Style="{StaticResource Caption}" />
                <Label Text="Nacht-Details" Style="{StaticResource H1}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource InfoBox}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Image Source="icon_info.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Start">
                        <Image.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Dark={StaticResource PrimaryBrightDark}, Light={StaticResource PrimaryBrightLight}}" />
                        </Image.Behaviors>
                    </Image>
                    <Label Grid.Column="1" Text="Timeline, Episodenliste und Wiedergabe der Aufnahmen folgen in Phase 5 und 7." Style="{StaticResource Body}" FontSize="13" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Nacht-ID" Style="{StaticResource Eyebrow}" />
                    <Label Text="{Binding NightId}" Style="{StaticResource Metric}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Zurück" Style="{StaticResource SecondaryButton}" Command="{Binding GoBackCommand}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
