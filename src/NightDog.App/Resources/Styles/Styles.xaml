<?xml version="1.0" encoding="UTF-8" ?>
<!-- Styles aus docs/Designsystem.md. Farben immer per AppThemeBinding (Dark ist Standard). -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Seiten & Shell -->

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Dark={StaticResource BgDark}, Light={StaticResource BgLight}}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Dark={StaticResource BgDark}, Light={StaticResource BgLight}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Dark={StaticResource TextDark}, Light={StaticResource TextLight}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Dark={StaticResource TextDark}, Light={StaticResource TextLight}}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Dark={StaticResource SurfaceDark}, Light={StaticResource SurfaceLight}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Dark={StaticResource PrimaryBrightDark}, Light={StaticResource PrimaryBrightLight}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Dark={StaticResource PrimaryBrightDark}, Light={StaticResource PrimaryBrightLight}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Dark={StaticResource TextMutedDark}, Light={StaticResource TextMutedLight}}" />
        <Setter Property="Shell.TabBarDisabledColor" Value="{AppThemeBinding Dark={StaticResource LineDark}, Light={StaticResource LineLight}}" />
    </Style>

    <!-- Typografie -->

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Dark={StaticResource TextDark}, Light={StaticResource TextLight}}" />
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="Display" TargetType="Label">
        <Setter Property="FontFamily" Value="InterLight" />
        <Setter Property="FontSize" Value="76" />
        <Setter Property="CharacterSpacing" Value="-3" />
    </Style>

    <Style x:Key="H1" TargetType="Label">
        <Setter Property="FontFamily" Value="InterExtraBold" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="CharacterSpacing" Value="-0.5" />
    </Style>

    <Style x:Key="H2" TargetType="Label">
        <Setter Property="FontFamily" Value="InterBold" />
        <Setter Property="FontSize" Value="17" />
    </Style>

    <Style x:Key="Metric" TargetType="Label">
        <Setter Property="FontFamily" Value="InterExtraBold" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="CharacterSpacing" Value="-0.5" />
    </Style>

    <Style x:Key="Body" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Dark={StaticResource TextSoftDark}, Light={StaticResource TextSoftLight}}" />
        <Setter Property="LineHeight" Value="1.5" />
    </Style>

    <Style x:Key="ItemTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
    </Style>

    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontFamily" Value="InterMedium" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Dark={StaticResource TextSoftDark}, Light={StaticResource TextSoftLight}}" />
    </Style>

    <Style x:Key="Eyebrow" TargetType="Label">
        <Setter Property="FontFamily" Value="InterBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="1.5" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="TextColor" Value="{AppThemeBinding Dark={StaticResource TextMutedDark}, Light={StaticResource TextMutedLight}}" />
    </Style>

    <!-- Buttons (Pill, 56 px) -->

    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource PrimaryGradientTop}" Offset="0" />
        <GradientStop Color="{StaticResource Primary}" Offset="1" />
    </LinearGradientBrush>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryGradient}" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="FontFamily" Value="InterBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="{StaticResource PrimaryDark}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{AppThemeBinding Dark={StaticResource SurfaceDark}, Light={StaticResource SurfaceLight}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Dark={StaticResource TextDark}, Light={StaticResource TextLight}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Dark={StaticResource LineDark}, Light={StaticResource LineLight}}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontFamily" Value="InterBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="Padding" Value="24,0" />
    </Style>

    <!-- Karten & Flächen -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Dark={StaticResource SurfaceDark}, Light={StaticResource SurfaceLight}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Dark={StaticResource LineDark}, Light={StaticResource LineLight}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 22" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="16,14" />
    </Style>

    <Style x:Key="IconBadge" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Dark={StaticResource Surface2Dark}, Light={StaticResource Surface2Light}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="40" />
    </Style>

    <Style x:Key="InfoBox" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Dark={StaticResource PrimarySoftDark}, Light={StaticResource PrimarySoftLight}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="16,14" />
    </Style>

    <Style x:Key="Divider" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{AppThemeBinding Dark={StaticResource LineDark}, Light={StaticResource LineLight}}" />
    </Style>

    <!-- Segment-Control: Container + Segment (IsSelected per DataTrigger in der Seite) -->

    <Style x:Key="SegmentTrack" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Dark={StaticResource BgDark}, Light={StaticResource Surface2Light}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style x:Key="Segment" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Transparent}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="HeightRequest" Value="36" />
    </Style>

    <Style x:Key="SegmentLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Dark={StaticResource TextSoftDark}, Light={StaticResource TextSoftLight}}" />
    </Style>

    <!-- Eingabe-Controls -->

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{StaticResource Primary}" />
        <Setter Property="ThumbColor" Value="{StaticResource White}" />
    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="TextColor" Value="{AppThemeBinding Dark={StaticResource TextDark}, Light={StaticResource TextLight}}" />
        <Setter Property="FontFamily" Value="InterBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="BackgroundColor" Value="{StaticResource Transparent}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Dark={StaticResource PrimaryBrightDark}, Light={StaticResource Primary}}" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{StaticResource Primary}" />
    </Style>

</ResourceDictionary>
